{
  "expo": {
    "name": "Zenvy Arc",
    "slug": "zenvyarc",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/art/logo-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#070605"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zenvyarc.app",
      "infoPlist": {
        "NSMotionUsageDescription": "Zenvy Arc uses motion data to count your steps automatically."
      }
    },
    "android": {
      "versionCode": 11,
      "adaptiveIcon": {
        "backgroundColor": "#070605",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.zenvyarc.app",
      "permissions": [
        "ACTIVITY_RECOGNITION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-dev-client"
    ],
    "extra": {
      "eas": {
        "projectId": "ad57b97e-95a8-4072-bf76-7a06107e0b80"
      }
    },
    "owner": "jeevansomu"
  }
}
